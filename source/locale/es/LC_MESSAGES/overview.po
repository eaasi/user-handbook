msgstr "Requisitos del sistema"

msgid "Hardware Requirements"
msgstr "Requisitos de hardware"

msgid "A VM or physical machine for the EaaSI gateway (*target* machine)."
msgstr "Una máquina VM o física para la puerta de entrada EaaSI (*target*)."

msgid "Minimal/testing:"
msgstr "Minimal/testing:"

msgid "8-core AMD64 CPU"
msgstr "8-core AMD64 CPU"

msgid "16 GB RAM"
msgstr "16 GB de RAM"

msgid "10 GB free disk space for the EaaSI system"
msgstr "10 GB de espacio libre de disco para el sistema EaaSI"

